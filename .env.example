# 复制为 .env 后按本机环境修改

# 数据库连接串：方言+驱动://用户名:密码@主机:端口/库名?字符集，aiomysql 为异步 MySQL 驱动
DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/渔获AI?charset=utf8mb4

# JWT 签名密钥，上线务必替换成随机长字符串
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_MINUTES=43200

DEBUG=true

# 微信小程序（微信登录 / 支付需要，留空则走模拟实现）
WECHAT_APPID=
WECHAT_SECRET=

# ---- 大模型（OpenAI 兼容协议）----
# 未配置 LLM_API_KEY 时，AI 研判自动退回后端本地确定性算法
# 换供应商只改这一段：如 Trae 网关 = https://console.enterprise.trae.cn
#   + LLM_PATH=/api/ide/v1/chat_completion + LLM_AUTH_HEADER=x-ide-token + LLM_AUTH_SCHEME=
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_PATH=/chat/completions
LLM_API_KEY=
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer
LLM_MODEL=deepseek-flash
LLM_STREAM=false
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1024

# ---- 真实天气数据源（和风天气 QWeather）----
# 和风天气 2026 年起废弃公共域名，必须填账号专属 API Host：
# 控制台 -> 设置 -> API Host（形如 abc123.xyz.qweatherapi.com）
QWEATHER_KEY=
QWEATHER_HOST=
